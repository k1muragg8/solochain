# Stage 1: Chef - Compute recipe
FROM rust:1.81 as chef
# Install cargo-chef
RUN cargo install cargo-chef
WORKDIR /app

# Stage 2: Planner - Create recipe.json
FROM chef as planner
COPY . .
# We need to handle the lock file correctly.
# If we are building from the root of the workspace, we should copy everything.
# However, this Containerfile is designed for standalone build context of kana-tui or needs the lock file.
# To make it robust, we'll assume the context includes the necessary files.
# If `Cargo.lock` is missing in `kana-tui`, we might regenerate it, which is acceptable if we are isolating it.
RUN cargo chef prepare --recipe-path recipe.json

# Stage 3: Builder - Build dependencies and application
FROM chef as builder
COPY --from=planner /app/recipe.json recipe.json
# Build dependencies - this is the caching layer!
RUN cargo chef cook --release --recipe-path recipe.json
# Build application
COPY . .
RUN cargo build --release --bin kana-tui

# Stage 4: Runtime - Minimal image
FROM gcr.io/distroless/cc-debian12
COPY --from=builder /app/target/release/kana-tui /usr/local/bin/kana-tui
ENTRYPOINT ["/usr/local/bin/kana-tui"]
